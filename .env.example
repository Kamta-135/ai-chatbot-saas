# Is file ko copy karke .env.local banao aur asli values bharo. .env.local ko kabhi git mein commit mat karo.

# --- Chat + image + search-query (zaroori) ---
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Supabase: documents (RAG), chat history (zaroori) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Live web search: "abhi ka" sawaalon ke liye (zaroori nahi, par recommended) ---
TAVILY_API_KEY=tvly-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Image analysis backup + (agar lib/embeddings.ts Gemini use karta hai to) embeddings ---
GEMINI_API_KEY=

# --- Voice ka official option (Azure Speech, free tier 5 lakh akshar/mahina). Na do to free msedge-tts chalega ---
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia

# --- Optional ---
# OPENROUTER_MODEL=openai/gpt-4.1-mini
# OPENROUTER_MODEL_FALLBACK=
# OPENROUTER_VISION_MODEL=openai/gpt-4.1-mini
# TTS_VOICE_HI=hi-IN-MadhurNeural
# TTS_VOICE_EN=en-IN-PrabhatNeural
# CRON_SECRET=koi-lamba-random-text   (Vercel keepalive cron ko protect karne ke liye)
